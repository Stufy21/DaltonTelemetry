diff --git a/src/openf1/util/f1_http.py b/src/openf1/util/f1_http.py
new file mode 100644
index 0000000..396373c
--- /dev/null
+++ b/src/openf1/util/f1_http.py
@@ -0,0 +1,18 @@
+import os
+
+import requests
+
+
+def f1_get(url: str, missing_ok: bool = False) -> requests.Response:
+    """GET on F1's live timing archive. The archive now requires the F1 TV subscription
+    token (set the F1_TOKEN environment variable) and rejects anonymous requests."""
+    token = os.getenv("F1_TOKEN")
+    headers = {"Authorization": f"Bearer {token}"} if token else {}
+    response = requests.get(url, headers=headers, timeout=120)
+    # The archive answers 403/404 for a feed a session never had: callers reading feeds can ignore it.
+    if missing_ok and response.status_code in (403, 404):
+        response.status_code = 200
+        response._content = b""
+        return response
+    response.raise_for_status()
+    return response
