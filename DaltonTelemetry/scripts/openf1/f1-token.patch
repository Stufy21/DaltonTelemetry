+def _drop_stale(collection: str, docs: list[Document], timepoint) -> list[Document]:
+    """Removes samples of a high-rate collection dated long before the message they came in"""
+    if collection not in _STALE_COLLECTIONS:
+        return docs
+    if getattr(timepoint, "tzinfo", None) is not None:
+        timepoint = timepoint.replace(tzinfo=None)
+    kept = []
+    for doc in docs:
+        date = getattr(doc, "date", None)
+        if date is not None and date.tzinfo is not None:
+            date = date.replace(tzinfo=None)
+        if date is not None and timepoint - date > STALE_AFTER:
+            continue
+        kept.append(doc)
+    return kept
