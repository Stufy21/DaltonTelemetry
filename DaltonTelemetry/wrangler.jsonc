// Cloudflare Workers configuration: the app is deployed as static assets (no Worker script).
// Build with `npm run build:cloudflare`, preview with `npm run preview:cloudflare`,
// publish with `npm run deploy:cloudflare`. See the README for the first-time setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daltontelemetry",
  "compatibility_date": "2026-10-14",
  // `wrangler deploy` builds the site first, so a Git-connected deploy needs no separate build command.
  "build": {
    "command": "npm run build:cloudflare"
  },
  // Custom domains: Cloudflare creates the DNS records and certificates on deploy. The zone must
  // already be active on this account, or the deploy fails.
  "routes": [
    { "pattern": "daltontv-telemetry.eu", "custom_domain": true },
    { "pattern": "www.daltontv-telemetry.eu", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/DaltonTelemetry/browser",
    // Routes with no file of their own (/live-timing, /reports/stats/:id) get the app shell.
    "not_found_handling": "single-page-application"
  }
}
